{
  "name": "sunlight-shadow-calculator",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "next typegen && tsc --noEmit",
    "sync:maplibre-worker": "cp node_modules/maplibre-gl/dist/maplibre-gl-worker.mjs public/maplibre/maplibre-gl-worker.mjs",
    "postinstall": "npm run sync:maplibre-worker"
  },
  "dependencies": {
    "@mapbox/vector-tile": "^3.0.0",
    "maplibre-gl": "^6.16.0",
    "next": "16.4.3",
    "pbf": "^5.1.2",
    "pmtiles": "^4.5.0",
    "pngjs": "^7.0.0",
    "polygon-clipping": "^0.15.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tz-lookup": "^6.1.25"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/tz-lookup": "^6.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "description": "3D sunlight and shadow calculator for any place and moment on Earth.",
